# Usuario que corresponde a las credenciales Basic de la API.
VITE_USUARIO_ID=1

# Sólo para desarrollo local. Ejemplo: Basic base64("correo@ejemplo.com:clave")
# No subas credenciales reales ni uses esta variable en un despliegue público.
VITE_API_AUTHORIZATION=Basic reemplazar_por_credencial

# Mantener /api usa el proxy configurado en Vite. Cambiar sólo si el frontend
# se sirve desde otro origen que tiene CORS configurado en el backend.
VITE_API_BASE_URL=/api
VITE_BACKEND_URL=http://localhost:8080
